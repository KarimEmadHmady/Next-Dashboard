PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=10041
DB_USER=root
DB_PASSWORD=root
DB_NAME=local

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin (Seed)
SEED_ADMIN_NAME="System Super Admin"
SEED_ADMIN_EMAIL=admin@roxy.com
SEED_ADMIN_PASSWORD=Admin@Password123

# External Store System Integration (WooCommerce / WordPress)
EXTERNAL_API_BASE_URL=https://backend.roxy-shawerma.com
EXTERNAL_API_LANG=ar
EXTERNAL_API_USERNAME=
EXTERNAL_API_PASSWORD=
EXTERNAL_API_TOKEN=
EXTERNAL_API_TIMEOUT_MS=10000
EXTERNAL_SYNC_INTERVAL_MINUTES=15
ORDERS_CACHE_TTL_SECONDS=30
ORDER_BRANCH_FIELD=branch_id
ORDER_AREA_FIELD=area_id

